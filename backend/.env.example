PORT=5679

# Production authentication mode for production-package Preview/Confirm.
# local-session is for the loopback-only Docker stack: the backend signs an
# HttpOnly cookie and the browser never receives a secret. gateway is for an
# external trusted auth gateway that signs identity assertions.
# local-session requires an allowed loopback Origin; Origin-less scripts must
# use gateway mode rather than silently receiving a browser session.
# PREVIEW_AUTH_MODE=local-session
# PREVIEW_LOCAL_SESSION_SECRET=base64url-encoded-32-byte-random-secret
# PREVIEW_LOCAL_SESSION_COOKIE_SECURE=false
#
# Gateway mode only: shared with the trusted gateway/host. Never commit it or
# send it to the browser. Missing/weak secrets keep gateway requests closed.
# PREVIEW_AUTH_PROXY_SECRET=base64url-encoded-32-byte-random-secret
# Preview resource budget (production Compose sets these explicitly)
# PREVIEW_REQUEST_MAX_CONCURRENT=8
# PREVIEW_REQUEST_MAX_SPOOL_BYTES=218103808
# Production should set both resource stores to mysql so reservations are
# shared across Node processes/replicas and recover automatically after crash.
# PREVIEW_REQUEST_RESOURCE_STORE=mysql
# PREVIEW_AUTH_NONCE_STORE_PATH=../data/preview-nonces
# PREVIEW_AUTH_NONCE_STORE=mysql
# PREVIEW_AUTH_NONCE_MAX_ENTRIES=100000

MYSQL_HOST=***********
MYSQL_PORT=******
MYSQL_USER=*******
MYSQL_PASSWORD=**********
MYSQL_DATABASE=**********
MYSQL_CONNECTION_LIMIT=********

# Optional. Defaults to ../data/static from compiled source location.
# STORAGE_PATH=../data/static

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios to the Seedance API (local /static paths
# are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
