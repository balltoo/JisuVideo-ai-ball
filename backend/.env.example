PORT=5679

# Base64url-encoded secret (at least 32 random bytes) shared only with the
# trusted auth gateway/host that signs the preview identity headers. Production
# docker-compose injects this from PREVIEW_AUTH_PROXY_SECRET in the deployment
# secret manager; never commit the value. Keep unset outside a configured
# gateway to keep preview closed; never use a client-provided identity header.
# PREVIEW_AUTH_PROXY_SECRET=base64url-encoded-32-byte-random-secret

MYSQL_HOST=***********
MYSQL_PORT=******
MYSQL_USER=*******
MYSQL_PASSWORD=**********
MYSQL_DATABASE=**********
MYSQL_CONNECTION_LIMIT=********

# Optional. Defaults to ../data/static from compiled source location.
# STORAGE_PATH=../data/static

# Optional. Public base URL of this backend. Required when passing locally
# uploaded reference videos/audios to the Seedance API (local /static paths
# are resolved as PUBLIC_BASE_URL + path).
# PUBLIC_BASE_URL=https://your-domain.com

# Optional. 关闭文本模型思考(thinking)模式,默认 true。
# 对 new-api 类中转站在请求体注入关思考参数,规避中转站强制回传
# reasoning_content 导致的 400;官方 OpenAI/Gemini 端点自动跳过。
# AI_DISABLE_THINKING=false
# 可选:自定义注入的 OpenAI 风格参数(JSON),适配不同中转站
# AI_THINKING_OFF_PATCH={"thinking":{"type":"disabled"},"enable_thinking":false}
